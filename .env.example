# Скопируй в .env и заполни (файл в .gitignore, сюда ключи не попадают):
#   cp .env.example .env

# Telegram-токен бота (обязателен)
BOT_TOKEN=

# Ключ OpenAI-совместимого LLM-провайдера (обязателен при llm.provider: "openai";
# для OpenRouter — начнётся с "sk-or-"). При llm.provider: "ollama" не нужен
LLM_API_KEY=

# Langfuse (необязательно; без них трейсы отключены)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
